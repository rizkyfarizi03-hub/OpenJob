# Server
HOST=localhost
PORT=3000

# PostgreSQL
PGUSER=ISI_USER_POSTGRESQL
PGPASSWORD=ISI_PASSWORD_POSTGRESQL
PGDATABASE=openjob_v2_test
PGHOST=localhost
PGPORT=5432

# JWT
ACCESS_TOKEN_KEY=GANTI_DENGAN_SECRET_KEY_ACAK
REFRESH_TOKEN_KEY=GANTI_DENGAN_SECRET_KEY_ACAK_LAINNYA
# Buat secret acak minimal 32 byte; nilai harus SAMA di API dan consumer.
PASSWORD_RESET_KEY=
WEB_BASE_URL=http://127.0.0.1:3000

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=openjob
RABBITMQ_PASSWORD=openjob_local_2026
# Harus SAMA dengan consumer; bedakan untuk setiap lingkungan.
RABBITMQ_QUEUE_PREFIX=openjob

# Opsional: URL koneksi lengkap (misalnya Neon). Bila diisi, PGUSER/PGPASSWORD/PGHOST/PGPORT/PGDATABASE diabaikan.
# DATABASE_URL=postgres://user:password@host/database?sslmode=require

# Opsional: simpan CV di database (dipakai di Vercel). Bawaan: folder uploads/documents.
# OPENJOB_DOCUMENT_STORAGE=database
