# PostgreSQL: database yang SAMA dengan openjob_api
PGUSER=ISI_USER_POSTGRESQL
PGPASSWORD=ISI_PASSWORD_POSTGRESQL
PGDATABASE=openjob_v2_test
PGHOST=localhost
PGPORT=5432

# RabbitMQ: harus memakai broker/akun/queue yang SAMA dengan openjob_api
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=openjob
RABBITMQ_PASSWORD=openjob_local_2026
# Harus SAMA dengan API; bedakan untuk setiap lingkungan.
RABBITMQ_QUEUE_PREFIX=openjob
# Jika menggunakan URL lengkap, isi AMQP_URL dan abaikan RABBITMQ_HOST/PORT/USER/PASSWORD
# AMQP_URL=amqp://openjob:openjob_local_2026@127.0.0.1:5672

# SMTP pengujian lokal dengan Mailpit; inbox di http://localhost:8025
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USER=openjob@localhost.test
MAIL_PASSWORD=local-only
# MAIL_FROM (opsional) untuk alamat pengirim berbeda dari login SMTP
# MAIL_FROM=openjob@localhost.test

# Secret reset harus SAMA dengan API, minimal 32 byte; jangan gunakan contoh sebagai secret.
PASSWORD_RESET_KEY=
WEB_BASE_URL=http://127.0.0.1:3000

# Opsional: URL koneksi lengkap (misalnya Neon). Bila diisi, PGUSER/PGPASSWORD/PGHOST/PGPORT/PGDATABASE diabaikan.
# DATABASE_URL=postgres://user:password@host/database?sslmode=require
